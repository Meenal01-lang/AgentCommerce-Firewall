# =========================================================================
#                    NEXUS ENGINE CONFIGURATION TEMPLATE
# =========================================================================

# 1. API SERVER PORT
PORT=5000

# 2. DATABASE CONFIGURATION
# SQLite database path (relative to backend/prisma/ directory)
DATABASE_URL="file:./dev.db"

# 3. MERCHANT DASHBOARD GATEWAY AUTHENTICATION
# Admin Dashboard uses this security token for writing firewall policy modifications
MERCHANT_AUTH_TOKEN=nexus-secret-key-2026

# 4. LLM API KEYS (Must set at least one for chatbot agent to function)
# Option A: Gemini API key (recommended)
GEMINI_API_KEY=your_gemini_api_key_here

# Option B: OpenAI API key (will be used if GEMINI_API_KEY is not defined)
OPENAI_API_KEY=your_openai_api_key_here

# 5. RAZORPAY TEST API KEYS (Must start with rzp_test_)
# If these keys are blank or set to rzp_test_mock_..., the gateway automatically
# falls back to a simulated checkout modal so you can fully test the success
# and failure flows offline without inputting keys.
RAZORPAY_KEY_ID=rzp_test_mock_id_2026
RAZORPAY_KEY_SECRET=mock_secret_2026

# 6. RAZORPAY WEBHOOK SECRET (For signature verification)
RAZORPAY_WEBHOOK_SECRET=nexus_webhook_secret_2026

# 7. FRONTEND CONFIG
# Used by Next.js in case API server is deployed to another host
NEXT_PUBLIC_API_URL=http://localhost:5000
